	(text_box "Note:\n-----\nMoved from Adafruite Feather nRF52840 Sense \nLoRa_RST - PIN9 - D9 (P0.26 | HS)\n\nTo -> TBD\n----\nMoved from Adafruite Feather nRF52840 Sense\nLoRa_DIO1 - PIN5 - D5 (P1.08 | HS)\n\nTo -> TBD\n----\nMoved from Adafruite Feather nRF52840 Sense\r\nLoRa_DIO2 - PIN6 - D6 (P0.07 | HS)\r\n\r\nTo -> TBD\r\n----\nMoved from Adafruite Feather nRF52840 Sense\r\nLoRa_CS - PIN10 - D10 (P0.27 | HS) (New Name: NSS)\r\n\r\nTo -> TBD\r\n----\nMoved from Adafruite Feather nRF52840 Sense\r\nLoRa_IRQ - PIN11 - D11 (P0.06 | HS) (New Name: DIO0)\r\n\r\nTo -> TBD\r\n----\n\nMoved from Adafruite Feather nRF52840 Sense\r\nBuzzer - PIN12 - D12 (P0.08 | HS)\n\nTo -> TBD\r\n----\n\nMoved from Adafruite Feather nRF52840 Sense\r\nVibration - PIN13 - D13 (P1.09 | HS)\r\n\r\nTo -> TBD\r\n----\n\r\nMoved from Adafruite Feather nRF52840 Sense\nTHUMBSTICK\n\r\nTMB2 - PINA0 - A0 (P0.04 | HS) To -> TBD\nTMBT1 - PINA1 - A1 (P0.30 | HS) To -> TBD\nTMB1 - PINA3 - A3 (P0.28 | HS) To -> TBD\r\n----"
		(exclude_from_sim no)
