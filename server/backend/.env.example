# PostgreSQL Database Configuration for Docker Development
# Copy this file to .env and customize as needed

# PostgreSQL Container Configuration
POSTGRES_DB=riot_db
POSTGRES_USER=riot_user
POSTGRES_PASSWORD=riot_password
POSTGRES_PORT=5432

# Spring Boot Application Configuration
DB_USERNAME=riot_user
DB_PASSWORD=riot_password
DB_URL=jdbc:postgresql://postgres:5432/riot_db

# Application Configuration
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# MQTT Configuration (from existing setup)
MQTT_BROKER=ssl://eu1.cloud.thethings.network:8883
MQTT_CLIENT_ID=mqtt-client-1234
MQTT_USERNAME=testing-area-1@ttn
MQTT_SUBSCRIBE_TOPIC=v3/testing-area-1@ttn/devices/+/up

# JWT Configuration
# IMPORTANT: Generate a strong 64+ character secret for production!
# Use: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=YourSecure64CharacterSecretKeyForProductionUseOnlyChangeThisImmediately1234567890

# Logging Configuration
LOGGING_LEVEL=INFO

# Security: Test Account Configuration (disable in production!)
TEST_CREDENTIALS_ACCOUNTS_0_USERNAME=test
TEST_CREDENTIALS_ACCOUNTS_0_PASSWORD=test123
TEST_CREDENTIALS_ACCOUNTS_0_EMAIL=test@example.com
TEST_CREDENTIALS_ACCOUNTS_0_ROLE=controller
